//Please rename the file to Jenkinsfile in order to run it in the Jenkins

pipeline {
    agent any

    environment {
        NEXUS_GROUP_URL = 'http://nexus-service:8081/cicd/nexus/repository/saturn-python-group/'
        NEXUS_HOSTED_URL = 'http://nexus-service:8081/cicd/nexus/repository/saturn-python-hosted/'
    }

    stages {
        stage('1. Checkout') {
            steps {
                echo 'Get Forgejo source code...'
                checkout scm
            }
        }

        stage('2. Setup Python Env') {
            steps {
                echo 'Setup Python venv and build tool...'
                withCredentials([usernamePassword(credentialsId: 'nexus-cicd-admin',
                                                  usernameVariable: 'NEXUS_USER',
                                                  passwordVariable: 'NEXUS_PASS')]) {

                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install --upgrade pip
                        pip install build twine

                        pip install --extra-index-url http://${NEXUS_USER}:${NEXUS_PASS}@nexus-service:8081/cicd/nexus/repository/saturn-python-group/ \
                                    --trusted-host nexus-service \
                                    -r requirements.txt
                    '''
                }
            }
        }

        stage('3. Lint & Test') {
            steps {
                sh '''
                    . venv/bin/activate
                    ruff check .
                    pytest --junitxml=report.xml
                '''
            }
        }

        stage('4. Build Package') {
            steps {
                echo 'Packing Python project (.whl & .tar.gz)...'
                sh '''
                    . venv/bin/activate
                    python3 -m build
                '''
            }
        }

        stage('5. Upload to Nexus') {
            steps {
                echo 'Uploading to Nexus (HTTP)...'
                withCredentials([usernamePassword(credentialsId: 'nexus-cicd-admin',
                                                  usernameVariable: 'NEXUS_USER',
                                                  passwordVariable: 'NEXUS_PASS')]) {
                    sh '''
                        . venv/bin/activate
                        twine upload --repository-url ${NEXUS_HOSTED_URL} \
                                     -u ${NEXUS_USER} -p ${NEXUS_PASS} \
                                     --verbose
                                     dist/*
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Python Build is completed and uploaded it to Nexus'
        }
        failure {
            echo 'Pipeline failed, please check Log。'
        }
    }
}